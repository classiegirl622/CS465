{{#> layout}}
<div class="box">
  <div>
    <div class="body">
      <h1>Travel</h1>
      <ul id="sites">
        {{!-- Module Three: generate a card for every JSON trip instead of hardcoding HTML. --}}
        {{#each trips}}
        <li>
          <a href="/travel"><img alt="{{name}}" src="/images/{{image}}"/></a>
          <h2><a href="/travel">{{name}}</a></h2>
          <p>{{description}}</p>
          {{#if details}}
          <p>{{details}}</p>
          {{/if}}
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
</div>
{{/layout}}
